# --- Base de donnees ---------------------------------------------------------
DATABASE_URL=postgresql://obrail:obrail@localhost:5432/obrail
CSV_PATH=./data/eu_trips_v2.csv
DB_HOST=localhost
DB_USER=obrail

# --- API ---------------------------------------------------------------------
OBRAIL_DATASET_PATH=./data/eu_trips_v2.csv
OBRAIL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Authentification --------------------------------------------------------
# Secret de signature des JWT. A REGENERER pour tout deploiement :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Ne jamais committer la valeur reelle : ce fichier est un modele, le .env l ignore.
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Comptes de demonstration crees par seed_users.py ------------------------
OBRAIL_VIEWER_USER=viewer
OBRAIL_VIEWER_PASSWORD=viewer123
OBRAIL_ADMIN_USER=admin
OBRAIL_ADMIN_PASSWORD=admin123

# --- Agent IA (C8 — Paramétrer un service d'intelligence artificielle) -------
# Fournisseur LLM : auto (defaut) | openrouter | ollama | rejeu
# En mode auto, le backend teste OpenRouter puis Ollama et bascule automatiquement.
OBRAIL_LLM_PROVIDER=auto

# Clé API OpenRouter — NE JAMAIS COMMITTER la valeur réelle.
# Obtenir une clé gratuite sur https://openrouter.ai/keys
# Laisser vide pour forcer Ollama en mode auto (aucun appel réseau).
OPENROUTER_API_KEY=

# Modèle à utiliser par fournisseur (valeurs par défaut recommandées)
OBRAIL_LLM_MODEL_OLLAMA=qwen3:8b
OBRAIL_LLM_MODEL_OPENROUTER=meta-llama/llama-3.3-70b-instruct:free

# URL de base de l'API compatible OpenAI exposée par Ollama.
# Depuis Docker, utiliser host.docker.internal pour atteindre le service
# tournant sur l'hôte Windows/macOS.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Détection automatique du fournisseur (mode auto)
OBRAIL_AGENT_AUTO_TIMEOUT_S=1.5
OBRAIL_AGENT_AUTO_CACHE_S=45

# Garde-fous de la boucle d'agent
OBRAIL_AGENT_MAX_ITERATIONS=5
OBRAIL_AGENT_TIMEOUT_S=60
OBRAIL_AGENT_MAX_TOKENS=800
OBRAIL_AGENT_TEMPERATURE=0
